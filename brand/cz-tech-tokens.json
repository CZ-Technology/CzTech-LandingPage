      },
      "superficies": {
        "canvas": { "valor": "#07101F", "uso": "Fundo da página" },
        "panel": { "valor": "#0A1629", "uso": "Fundo alternativo das seções" },
        "stage": { "valor": "#0C1932", "uso": "Palco que agrupa cards" },
        "card": { "valor": "#122240", "uso": "Superfície dos cards" },
