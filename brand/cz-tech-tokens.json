      },
      "superficies": {
        "canvas": { "valor": "#EEF4FB", "uso": "Fundo da página" },
        "panel": { "valor": "#F8FBFF", "uso": "Fundo alternativo das seções" },
        "stage": { "valor": "#E3EBF6", "uso": "Palco que agrupa cards" },
        "card": { "valor": "#FFFFFF", "uso": "Superfície dos cards" },
        "night": { "valor": "#061430", "uso": "Rodapé, hero e faixas escuras" }
      },
      "texto": {
        "text-primary": { "valor": "#0B1A33", "uso": "Texto principal e blocos escuros" },
        "text-secondary": { "valor": "#4E6180", "uso": "Descrições e rótulos" }
      },
      "linhas": {
